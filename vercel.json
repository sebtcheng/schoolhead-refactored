{
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    {
      "source": "/insighted-schoolhead/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
